# Desarrollo local (opcional: sin esto Vite usa el proxy a :3001)
VITE_SIGNALING_URL=http://localhost:3001

# TURN — necesario para conexiones entre redes distintas (ej. móvil en 4G)
# Obtén credenciales en https://www.metered.ca/stun-turn o Twilio/Xirsys
# VITE_TURN_URL=turn:a.relay.metered.ca:80,turn:a.relay.metered.ca:443,turn:a.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=tu_usuario
# VITE_TURN_CREDENTIAL=tu_credencial
